        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Calculate frequency of each focus area\n",
        "# Taking top 15 to keep the pie chart readable\n",
        "focus_counts = df['focus_area'].value_counts().head(15)\n",
        "\n",
        "# Custom function to show absolute counts instead of percentages\n",
        "def make_autopct(values):\n",
        "    def my_autopct(pct):\n",
        "        total = sum(values)\n",
        "        val = int(round(pct*total/100.0))\n",
        "        return '{v:d}'.format(v=val)\n",
        "    return my_autopct\n",
