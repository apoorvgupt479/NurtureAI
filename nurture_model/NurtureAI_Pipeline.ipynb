        "\n",
        "# ── Holdout split ─────────────────────────────────────────────────\n",
        "avail = [f for f in feature_names if f in train_feat.columns]\n",
        "X_all = train_feat[avail]; y_all = train_feat[TARGET].astype(int)\n",
        "\n",
        "X_tr, X_te, y_tr, y_te = train_test_split(X_all, y_all, test_size=0.20, stratify=y_all, random_state=42)\n",
