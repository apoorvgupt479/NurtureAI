        "# ── Plot 3: Physical Features by Risk ────────────────────────────\n",
        "print(\"📊 Plot 3: Physical Health Indicators by Risk Level\")\n",
        "kws  = [\"bmi\", \"weight\", \"height\", \"waist\", \"heartrate\", \"fat\"]\n",
        "cols = [c for c in df_eda.columns if any(k in c.lower() for k in kws) and c != TARGET][:6]\n",
        "\n",
        "fig, axes = plt.subplots(2, 3, figsize=(15, 9))\n",
