        "     \"data\": {\"Basic_Demos-Age\": 10, \"Basic_Demos-Sex\": 0,\n",
        "               \"Physical-BMI\": 18.5, \"Physical-Height\": 140, \"Physical-Weight\": 36,\n",
        "               \"Physical-Waist_Circumference\": 60, \"Physical-Diastolic_BP\": 65,\n",
