      "source": [
        "# ════════════════════════════════════════════════════════════\n",
        "#  STEP 4 — FEATURE ENGINEERING\n",
        "# ════════════════════════════════════════════════════════════\n",
        "\n",
        "def _find(df, kws):\n",
        "    for k in kws:\n",
        "        m = next((c for c in df.columns if k.lower() in c.lower()), None)\n",
        "        if m: return m\n",
        "    return None\n",
        "\n",
        "\n",
        "def add_bmi_category(df):\n",
        "    col = _find(df, [\"bmi\"])\n",
        "    if col:\n",
        "        df[\"BMI_Category\"] = pd.cut(df[col], bins=[0,18.5,25,30,100], labels=[0,1,2,3]).astype(float)\n",
        "        print(f\"  [FE] BMI_Category  ← {col}\")\n",
        "    return df\n",
        "\n",
        "\n",
        "def add_age_group(df):\n",
        "    col = _find(df, [\"age\"])\n",
        "    if col:\n",
        "        df[\"Age_Group\"] = pd.cut(df[col], bins=[0,11,14,17,100], labels=[0,1,2,3]).astype(float)\n",
        "        print(f\"  [FE] Age_Group     ← {col}\")\n",
        "    return df\n",
        "\n",
        "\n",
        "def add_pulse_pressure(df):\n",
        "    s = _find(df, [\"systolic\"]); d = _find(df, [\"diastolic\"])\n",
        "    if s and d:\n",
        "        df[\"Pulse_Pressure\"] = df[s] - df[d]\n",
        "        print(f\"  [FE] Pulse_Pressure ← {s} - {d}\")\n",
        "    return df\n",
        "\n",
        "\n",
        "def add_body_comp_index(df):\n",
        "    fat = _find(df, [\"fat\"]); ffm = _find(df, [\"ffm\"])\n",
        "    if fat and ffm:\n",
        "        df[\"Body_Comp_Index\"] = df[fat] / (df[ffm] + 1e-5)\n",
        "        print(f\"  [FE] Body_Comp_Index ← {fat} / {ffm}\")\n",
        "    return df\n",
        "\n",
        "\n",
        "def add_behavior_score(df):\n",
        "    \"\"\"\n",
        "    Composite Behavior Score (0–100).\n",
        "    Higher = healthier behavioural profile.\n",
        "    Weights: 35% sleep + 35% activity + 20% fitness + 10% BMI\n",
        "    \"\"\"\n",
        "    scaler = MinMaxScaler(); parts = []\n",
        "\n",
        "    sds = _find(df, [\"sds\", \"sleep\"])\n",
        "    if sds:\n",
        "        scaled = scaler.fit_transform(df[[sds]])\n",
        "        parts.append((1 - scaled.flatten()) * 35)   # invert: low disturbance = good\n",
        "        print(f\"  [FE] BehaviorScore ← sleep    ({sds})\")\n",
        "\n",
        "    paq = _find(df, [\"paq_a\", \"paq_c\", \"paq\"])\n",
        "    if paq:\n",
        "        scaled = scaler.fit_transform(df[[paq]])\n",
        "        parts.append(scaled.flatten() * 35)\n",
        "        print(f\"  [FE] BehaviorScore ← activity ({paq})\")\n",
        "\n",
        "    fit = _find(df, [\"max_stage\", \"endurance\"])\n",
        "    if fit:\n",
        "        scaled = scaler.fit_transform(df[[fit]])\n",
        "        parts.append(scaled.flatten() * 20)\n",
        "        print(f\"  [FE] BehaviorScore ← fitness  ({fit})\")\n",
        "\n",
        "    bmi = _find(df, [\"bmi\"])\n",
        "    if bmi:\n",
        "        pen = np.abs(df[bmi] - 21.5)\n",
        "        scaled = scaler.fit_transform(pen.values.reshape(-1,1))\n",
        "        parts.append((1 - scaled.flatten()) * 10)\n",
        "        print(f\"  [FE] BehaviorScore ← BMI      ({bmi})\")\n",
        "\n",
        "    if parts:\n",
        "        raw = sum(parts); lo, hi = raw.min(), raw.max()\n",
        "        df[\"Behavior_Score\"] = (raw - lo) / (hi - lo + 1e-8) * 100\n",
        "        print(f\"  [FE] Behavior_Score range: {df['Behavior_Score'].min():.1f}–{df['Behavior_Score'].max():.1f}\")\n",
        "    else:\n",
        "        df[\"Behavior_Score\"] = 50.0\n",
        "    return df\n",
        "\n",
        "\n",
        "def drop_low_variance(df, threshold=0.01):\n",
        "    feats = [c for c in df.select_dtypes(include=[np.number]).columns if c != TARGET]\n",
        "    low   = [c for c in feats if df[c].var() < threshold]\n",
        "    if low:\n",
        "        df = df.drop(columns=low)\n",
        "        print(f\"  [SELECT] Dropped {len(low)} near-zero-variance features\")\n",
        "    print(f\"  [SELECT] Final: {df.shape[1]-1} features + target\")\n",
        "    return df\n",
        "\n",
        "\n",
        "def engineer(df, is_train=True):\n",
        "    df = add_bmi_category(df)\n",
        "    df = add_age_group(df)\n",
        "    df = add_pulse_pressure(df)\n",
        "    df = add_body_comp_index(df)\n",
        "    df = add_behavior_score(df)\n",
        "    if is_train: df = drop_low_variance(df)\n",
        "    return df\n",
        "\n",
        "\n",
        "print(\"\\n\" + \"=\"*55)\n",
        "print(\"  STEP 4 — FEATURE ENGINEERING\")\n",
        "print(\"=\"*55)\n",
        "\n",
        "train_feat = engineer(train_clean.copy(), is_train=True)\n",
        "if test_clean is not None:\n",
        "    test_feat = engineer(test_clean.copy(), is_train=False)\n",
        "    train_feats_list = [c for c in train_feat.columns if c != TARGET]\n",
        "    test_feat = test_feat.reindex(columns=train_feats_list, fill_value=0)\n",
        "else:\n",
        "    test_feat = None\n",
        "\n",
        "print(f\"\\n✅ Train shape after FE: {train_feat.shape}\")\n",
        "print(\"\\nNew features added:\")\n",
        "new_feats = [\"BMI_Category\", \"Age_Group\", \"Pulse_Pressure\", \"Body_Comp_Index\", \"Behavior_Score\"]\n",
        "for f in new_feats:\n",
        "    if f in train_feat.columns:\n",
        "        print(f\"  ✅ {f}\")\n",
        "\n",
        "display(train_feat[[\"Behavior_Score\", \"BMI_Category\", \"Age_Group\", \"Pulse_Pressure\", TARGET]].head(5))\n"
      ]
    },
