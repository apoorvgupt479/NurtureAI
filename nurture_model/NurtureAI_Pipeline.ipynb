      "source": [
        "import pandas as pd\n",
        "\n",
        "# Assuming train_feat is available from Step 4's execution\n",
        "# If running independently, ensure train_clean is available and engineer function is defined.\n",
        "\n",
        "if 'train_feat' not in globals():\n",
        "    print(\"train_feat not found, re-running clean_pipeline and engineer functions...\")\n",
        "    # Re-using functions defined in previous cells for robustness if run standalone\n",
        "    from sklearn.impute import SimpleImputer\n",
        "    from sklearn.preprocessing import MinMaxScaler\n",
        "    import numpy as np\n",
        "    import os\n",
        "\n",
        "    # Dummy constants and target labels if not defined (for standalone execution)\n",
        "    TARGET = \"sii\"\n",
        "    TARGET_LABELS = {0: \"None (Healthy)\", 1: \"Mild\", 2: \"Moderate\", 3: \"Severe\"}\n",
        "    PALETTE = {0: \"#2ecc71\", 1: \"#f1c40f\", 2: \"#e67e22\", 3: \"#e74c3c\"}\n",
        "    LABELS_PLOT = {0: \"None\\n(Healthy)\", 1: \"Mild\\nRisk\", 2: \"Moderate\\nRisk\", 3: \"Severe\\nRisk\"}\n",
        "    USE_REAL_DATA = False\n",
        "\n",
        "    def make_demo_data(n=3000, seed=42):\n",
        "        np.random.seed(seed)\n",
        "        age   = np.random.randint(5, 23, n)\n",
        "        sex   = np.random.choice([0, 1], n)\n",
        "        bmi   = np.random.normal(22, 4, n).clip(13, 40)\n",
        "        ht    = np.random.normal(155, 20, n).clip(90, 200)\n",
        "        wt    = np.random.normal(55, 15, n).clip(15, 120)\n",
        "        waist = np.random.normal(72, 12, n).clip(40, 120)\n",
        "        dbp   = np.random.normal(70, 10, n).clip(50, 100)\n",
        "        sbp   = np.random.normal(115, 15, n).clip(80, 160)\n",
        "        hr    = np.random.normal(75, 12, n).clip(50, 120)\n",
        "        sds   = np.random.normal(50, 10, n).clip(20, 80)\n",
        "        fit_s = np.random.randint(1, 15, n).astype(float)\n",
        "        fit_t = np.random.randint(5, 60, n).astype(float)\n",
        "        paq_a = np.random.normal(2.5, 0.8, n).clip(1, 4)\n",
        "        paq_c = np.random.normal(2.5, 0.8, n).clip(1, 4)\n",
        "        bia_f = np.random.normal(20, 8, n).clip(5, 50)\n",
        "        bia_m = np.random.normal(40, 10, n).clip(15, 80)\n",
        "        bia_s = np.random.normal(30, 8, n).clip(10, 60)\n",
        "\n",
        "        df = pd.DataFrame({\n",
        "            \"id\":                              [f\"P_{i:05d}\" for i in range(n)],\n",
        "            \"Basic_Demos-Age\":                 age,\n",
        "            \"Basic_Demos-Sex\":                 sex,\n",
        "            \"Physical-BMI\":                    bmi,\n",
        "            \"Physical-Height\":                 ht,\n",
        "            \"Physical-Weight\":                 wt,\n",
        "            \"Physical-Waist_Circumference\":    waist,\n",
        "            \"Physical-Diastolic_BP\":           dbp,\n",
        "            \"Physical-Systolic_BP\":            sbp,\n",
        "            \"Physical-HeartRate\":              hr,\n",
        "            \"SDS-SDS_Total_T\":                 sds,\n",
        "            \"Fitness_Endurance-Max_Stage\":     fit_s,\n",
        "            \"Fitness_Endurance-Time_Mins\":     fit_t,\n",
        "            \"PAQ_A-PAQ_A_Total\":               paq_a,\n",
        "            \"PAQ_C-PAQ_C_Total\":               paq_c,\n",
        "            \"BIA-BIA_Fat\":                     bia_f,\n",
        "            \"BIA-BIA_FFM\":                     bia_m,\n",
        "            \"BIA-BIA_SMM\":                     bia_s,\n",
        "        })\n",
        "\n",
        "        for col in [\"Fitness_Endurance-Max_Stage\", \"Fitness_Endurance-Time_Mins\",\n",
        "                    \"BIA-BIA_Fat\", \"BIA-BIA_FFM\", \"BIA-BIA_SMM\", \"SDS-SDS_Total_T\"]:\n",
        "            df.loc[np.random.rand(n) < 0.30, col] = np.nan\n",
        "\n",
        "        risk = ((sds-50)/30*0.5 + (2.5-paq_a)/1.5*0.3 + np.clip((bmi-25)/15,0,1)*0.2)\n",
        "        raw  = np.random.uniform(0, 80, n) + risk * 20\n",
        "        sii  = pd.cut(raw, bins=[-999,30,49,59,999], labels=[0,1,2,3]).astype(float)\n",
        "        noise = np.random.rand(n) < 0.08\n",
        "        sii[noise] = np.random.choice([0,1,2,3], noise.sum())\n",
        "        df[\"sii\"] = pd.array(sii.round().clip(0,3), dtype=\"Int64\")\n",
        "        df.loc[np.random.rand(n) < 0.14, \"sii\"] = pd.NA\n",
        "\n",
        "        train_df = df.iloc[:2500].copy()\n",
        "        test_df  = df.iloc[2500:].drop(columns=[\"sii\"]).copy()\n",
        "        return train_df, test_df\n",
        "\n",
        "    train_raw, test_raw = make_demo_data()\n",
        "\n",
        "    def identify_cols(df):\n",
        "        num_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n",
        "        str_cols = [c for c in df.columns if df[c].dtype == object or str(df[c].dtype) == \"str\"]\n",
        "        id_cols  = [c for c in df.columns if c.lower() in (\"id\", \"uid\", \"participant_id\")]\n",
        "        num_feat = [c for c in num_cols if c not in [TARGET] + id_cols]\n",
        "        return id_cols, str_cols, num_feat\n",
        "\n",
        "    def drop_high_missing(df, thresh=0.60):\n",
        "        frac  = df.isnull().mean()\n",
        "        drops = frac[frac > thresh].index.tolist()\n",
        "        if drops:\n",
        "            df = df.drop(columns=drops)\n",
        "        return df, drops\n",
        "\n",
        "    def encode_categoricals(df, str_cols):\n",
        "        encoded, dropped = [], []\n",
        "        for col in str_cols:\n",
        "            if col not in df.columns: continue\n",
        "            n_unique = df[col].nunique(dropna=True)\n",
        "            if n_unique <= 1 or n_unique > 10:\n",
        "                df = df.drop(columns=[col]); dropped.append(col)\n",
        "            elif n_unique == 2:\n",
        "                vals = sorted(df[col].dropna().unique())\n",
        "                df[col] = df[col].map({v: i for i, v in enumerate(vals)}); encoded.append(col)\n",
        "            else:\n",
        "                dummies = pd.get_dummies(df[col], prefix=col, drop_first=True)\n",
        "                df = pd.concat([df.drop(columns=[col]), dummies], axis=1); encoded.append(col)\n",
        "        return df\n",
        "\n",
        "    def remove_target_nulls(df):\n",
        "        df = df.dropna(subset=[TARGET]).copy()\n",
        "        df[TARGET] = df[TARGET].astype(int)\n",
        "        return df\n",
        "\n",
        "    def impute_numeric(df, cols):\n",
        "        present = [c for c in cols if c in df.columns]\n",
        "        if present:\n",
        "            imp = SimpleImputer(strategy=\"median\")\n",
        "            df[present] = imp.fit_transform(df[present])\n",
        "        return df\n",
        "\n",
        "    def clean_pipeline(train, test=None):\n",
        "        id_cols, str_cols, num_feat = identify_cols(train)\n",
        "        train = train.drop(columns=[c for c in id_cols if c in train.columns], errors=\"ignore\")\n",
        "        if test is not None:\n",
        "            test = test.drop(columns=[c for c in id_cols if c in test.columns], errors=\"ignore\")\n",
        "        train, dropped = drop_high_missing(train)\n",
        "        if test is not None:\n",
        "            test = test.drop(columns=[c for c in dropped if c in test.columns], errors=\"ignore\")\n",
        "        str_cols = [c for c in str_cols if c in train.columns and c not in id_cols]\n",
        "        train = encode_categoricals(train, str_cols)\n",
        "        if test is not None:\n",
        "            test = encode_categoricals(test, [c for c in str_cols if c in test.columns])\n",
        "        train = remove_target_nulls(train)\n",
        "        _, _, num_feat = identify_cols(train)\n",
        "        train = impute_numeric(train, num_feat)\n",
        "        if test is not None:\n",
        "            _, _, num_feat_t = identify_cols(test)\n",
        "            test = impute_numeric(test, num_feat_t)\n",
        "        return train, test\n",
        "\n",
        "    train_clean, test_clean = clean_pipeline(train_raw.copy(), test_raw.copy() if test_raw is not None else None)\n",
        "\n",
        "    def _find(df, kws):\n",
        "        for k in kws:\n",
        "            m = next((c for c in df.columns if k.lower() in c.lower()), None)\n",
        "            if m: return m\n",
        "        return None\n",
        "\n",
        "    def add_bmi_category(df):\n",
        "        col = _find(df, [\"bmi\"])\n",
        "        if col:\n",
        "            df[\"BMI_Category\"] = pd.cut(df[col], bins=[0,18.5,25,30,100], labels=[0,1,2,3]).astype(float)\n",
        "        return df\n",
        "\n",
        "    def add_age_group(df):\n",
        "        col = _find(df, [\"age\"])\n",
        "        if col:\n",
        "            df[\"Age_Group\"] = pd.cut(df[col], bins=[0,11,14,17,100], labels=[0,1,2,3]).astype(float)\n",
        "        return df\n",
        "\n",
        "    def add_pulse_pressure(df):\n",
        "        s = _find(df, [\"systolic\"]); d = _find(df, [\"diastolic\"])\n",
        "        if s and d:\n",
        "            df[\"Pulse_Pressure\"] = df[s] - df[d]\n",
        "        return df\n",
        "\n",
        "    def add_body_comp_index(df):\n",
        "        fat = _find(df, [\"fat\"]); ffm = _find(df, [\"ffm\"])\n",
        "        if fat and ffm:\n",
        "            df[\"Body_Comp_Index\"] = df[fat] / (df[ffm] + 1e-5)\n",
        "        return df\n",
        "\n",
        "    def add_behavior_score(df):\n",
        "        scaler = MinMaxScaler(); parts = []\n",
        "        sds = _find(df, [\"sds\", \"sleep\"])\n",
        "        if sds:\n",
        "            scaled = scaler.fit_transform(df[[sds]])\n",
        "            parts.append((1 - scaled.flatten()) * 35)\n",
        "        paq = _find(df, [\"paq_a\", \"paq_c\", \"paq\"])\n",
        "        if paq:\n",
        "            scaled = scaler.fit_transform(df[[paq]])\n",
        "            parts.append(scaled.flatten() * 35)\n",
        "        fit = _find(df, [\"max_stage\", \"endurance\"])\n",
        "        if fit:\n",
        "            scaled = scaler.fit_transform(df[[fit]])\n",
        "            parts.append(scaled.flatten() * 20)\n",
        "        bmi = _find(df, [\"bmi\"])\n",
        "        if bmi:\n",
        "            pen = np.abs(df[bmi] - 21.5)\n",
        "            scaled = scaler.fit_transform(pen.values.reshape(-1,1))\n",
        "            parts.append((1 - scaled.flatten()) * 10)\n",
        "        if parts:\n",
        "            raw = sum(parts); lo, hi = raw.min(), raw.max()\n",
        "            df[\"Behavior_Score\"] = (raw - lo) / (hi - lo + 1e-8) * 100\n",
        "        else:\n",
        "            df[\"Behavior_Score\"] = 50.0\n",
        "        return df\n",
        "\n",
        "    def drop_low_variance(df, threshold=0.01):\n",
        "        feats = [c for c in df.select_dtypes(include=[np.number]).columns if c != TARGET]\n",
        "        low   = [c for c in feats if df[c].var() < threshold]\n",
        "        if low:\n",
        "            df = df.drop(columns=low)\n",
        "        return df\n",
        "\n",
        "    def engineer(df, is_train=True):\n",
        "        df = add_bmi_category(df)\n",
        "        df = add_age_group(df)\n",
        "        df = add_pulse_pressure(df)\n",
        "        df = add_body_comp_index(df)\n",
        "        df = add_behavior_score(df)\n",
        "        if is_train: df = drop_low_variance(df)\n",
        "        return df\n",
        "\n",
        "    train_feat = engineer(train_clean.copy(), is_train=True)\n",
        "\n",
        "display(train_feat[[\"Behavior_Score\", \"BMI_Category\", \"Age_Group\", \"Pulse_Pressure\", TARGET]].head(5))\n"
      ],
