      "source": [
        "# ════════════════════════════════════════════════════════════\n",
        "#  STEP 1 — DATA UNDERSTANDING\n",
        "# ════════════════════════════════════════════════════════════\n",
        "\n",
        "def make_demo_data(n=3000, seed=42):\n",
        "    \"\"\"\n",
        "    Generates synthetic data mirroring the real CMI-PIU dataset.\n",
        "    Same column names, dtypes, missing patterns, and target distribution.\n",
        "    \"\"\"\n",
        "    np.random.seed(seed)\n",
        "    age   = np.random.randint(5, 23, n)\n",
        "    sex   = np.random.choice([0, 1], n)\n",
        "    bmi   = np.random.normal(22, 4, n).clip(13, 40)\n",
        "    ht    = np.random.normal(155, 20, n).clip(90, 200)\n",
        "    wt    = np.random.normal(55, 15, n).clip(15, 120)\n",
        "    waist = np.random.normal(72, 12, n).clip(40, 120)\n",
        "    dbp   = np.random.normal(70, 10, n).clip(50, 100)\n",
        "    sbp   = np.random.normal(115, 15, n).clip(80, 160)\n",
        "    hr    = np.random.normal(75, 12, n).clip(50, 120)\n",
        "    sds   = np.random.normal(50, 10, n).clip(20, 80)\n",
        "    fit_s = np.random.randint(1, 15, n).astype(float)\n",
        "    fit_t = np.random.randint(5, 60, n).astype(float)\n",
        "    paq_a = np.random.normal(2.5, 0.8, n).clip(1, 4)\n",
        "    paq_c = np.random.normal(2.5, 0.8, n).clip(1, 4)\n",
        "    bia_f = np.random.normal(20, 8, n).clip(5, 50)\n",
        "    bia_m = np.random.normal(40, 10, n).clip(15, 80)\n",
        "    bia_s = np.random.normal(30, 8, n).clip(10, 60)\n",
        "\n",
        "    df = pd.DataFrame({\n",
        "        \"id\":                              [f\"P_{i:05d}\" for i in range(n)],\n",
        "        \"Basic_Demos-Age\":                 age,\n",
        "        \"Basic_Demos-Sex\":                 sex,\n",
        "        \"Physical-BMI\":                    bmi,\n",
        "        \"Physical-Height\":                 ht,\n",
        "        \"Physical-Weight\":                 wt,\n",
        "        \"Physical-Waist_Circumference\":    waist,\n",
        "        \"Physical-Diastolic_BP\":           dbp,\n",
        "        \"Physical-Systolic_BP\":            sbp,\n",
        "        \"Physical-HeartRate\":              hr,\n",
        "        \"SDS-SDS_Total_T\":                 sds,\n",
        "        \"Fitness_Endurance-Max_Stage\":     fit_s,\n",
        "        \"Fitness_Endurance-Time_Mins\":     fit_t,\n",
        "        \"PAQ_A-PAQ_A_Total\":               paq_a,\n",
        "        \"PAQ_C-PAQ_C_Total\":               paq_c,\n",
        "        \"BIA-BIA_Fat\":                     bia_f,\n",
        "        \"BIA-BIA_FFM\":                     bia_m,\n",
        "        \"BIA-BIA_SMM\":                     bia_s,\n",
        "    })\n",
        "\n",
        "    # ~30% missing in fitness / BIA / sleep (same as real dataset)\n",
        "    for col in [\"Fitness_Endurance-Max_Stage\", \"Fitness_Endurance-Time_Mins\",\n",
        "                \"BIA-BIA_Fat\", \"BIA-BIA_FFM\", \"BIA-BIA_SMM\", \"SDS-SDS_Total_T\"]:\n",
        "        df.loc[np.random.rand(n) < 0.30, col] = np.nan\n",
        "\n",
        "    # Target with realistic lifestyle signal\n",
        "    risk = ((sds-50)/30*0.5 + (2.5-paq_a)/1.5*0.3 + np.clip((bmi-25)/15,0,1)*0.2)\n",
        "    raw  = np.random.uniform(0, 80, n) + risk * 20\n",
        "    sii  = pd.cut(raw, bins=[-999,30,49,59,999], labels=[0,1,2,3]).astype(float)\n",
        "    noise = np.random.rand(n) < 0.08\n",
        "    sii[noise] = np.random.choice([0,1,2,3], noise.sum())\n",
        "    df[\"sii\"] = pd.array(sii.round().clip(0,3), dtype=\"Int64\")\n",
        "    df.loc[np.random.rand(n) < 0.14, \"sii\"] = pd.NA   # ~14% missing labels\n",
        "\n",
        "    train_df = df.iloc[:2500].copy()\n",
        "    test_df  = df.iloc[2500:].drop(columns=[\"sii\"]).copy()\n",
        "    return train_df, test_df\n",
        "\n",
        "\n",
        "# ── Load data ─────────────────────────────────────────────────────\n",
        "if USE_REAL_DATA and os.path.exists(\"/content/train.csv\"):\n",
        "    print(\"Loading REAL Kaggle data...\")\n",
        "    train_raw = pd.read_csv(\"/content/train.csv\")\n",
        "    test_raw  = pd.read_csv(\"/content/test.csv\") if os.path.exists(\"/content/test.csv\") else None\n",
        "    print(f\"✅ Real data loaded: {train_raw.shape}\")\n",
        "else:\n",
        "    print(\"Generating synthetic demo dataset (mirrors real CMI-PIU structure)...\")\n",
        "    train_raw, test_raw = make_demo_data()\n",
        "    print(f\"✅ Synthetic data generated: train={train_raw.shape}, test={test_raw.shape}\")\n",
        "\n",
        "# ── Overview ──────────────────────────────────────────────────────\n",
        "print(f\"\\n{'='*55}\")\n",
        "print(\"  TRAINING SET OVERVIEW\")\n",
        "print(f\"{'='*55}\")\n",
        "print(f\"  Rows x Columns : {train_raw.shape[0]:,} x {train_raw.shape[1]}\")\n",
        "print(f\"  Memory usage   : {train_raw.memory_usage(deep=True).sum()/1024:.1f} KB\")\n",
        "\n",
        "print(\"\\n📋 Column dtypes:\")\n",
        "print(train_raw.dtypes.value_counts().to_string())\n",
        "\n",
        "print(\"\\n❗ Missing values:\")\n",
        "miss = train_raw.isnull().sum()\n",
        "miss_pct = (miss / len(train_raw) * 100).round(1)\n",
        "miss_df = pd.DataFrame({\"Count\": miss, \"Pct %\": miss_pct})\n",
        "print(miss_df[miss_df[\"Count\"] > 0].sort_values(\"Pct %\", ascending=False).to_string())\n",
        "\n",
        "print(f\"\\n🎯 Target (sii) distribution:\")\n",
        "for val, cnt in train_raw[TARGET].value_counts(dropna=False).sort_index().items():\n",
        "    pct = cnt / len(train_raw) * 100\n",
        "    lbl = TARGET_LABELS.get(val, \"Missing\")\n",
        "    bar = \"█\" * int(pct / 2)\n",
        "    print(f\"  sii={str(val):<5}  {lbl:<16}  {cnt:>5}  ({pct:>5.1f}%)  {bar}\")\n",
        "\n",
        "print(\"\\n📄 First 3 rows:\")\n",
        "display(train_raw.head(3))\n"
      ]
    },
