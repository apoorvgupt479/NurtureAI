        "# ── Feature Importance (SVM Coefficients) ──────────────────────\n",
        "print(\"📊 Feature Importance Plot — LinearSVC Coefficients\")\n",
        "\n",
        "# LinearSVC wrapped in CalibratedClassifierCV: access the underlying estimator\n",
        "# to extract linear coefficients as a proxy for feature importance.\n",
        "def get_svm_feature_importance(model, feature_names):\n",
        "    \"\"\"Extract mean absolute coefficient across all classes from a CalibratedClassifierCV(LinearSVC).\"\"\"\n",
        "    try:\n",
        "        # CalibratedClassifierCV has multiple calibrated_classifiers\n",
        "        coef_list = []\n",
        "        for cal in model.calibrated_classifiers_:\n",
        "            base = cal.estimator  # the LinearSVC inside\n",
        "            if hasattr(base, 'coef_'):\n",
        "                coef_list.append(np.abs(base.coef_).mean(axis=0))\n",
        "        if coef_list:\n",
        "            return np.mean(coef_list, axis=0)\n",
        "    except AttributeError:\n",
        "        pass\n",
        "    # Fallback: direct LinearSVC\n",
        "    if hasattr(model, 'coef_'):\n",
        "        return np.abs(model.coef_).mean(axis=0)\n",
        "    return None\n",
        "\n",
        "imp = get_svm_feature_importance(best_model, avail)\n",
        "\n",
        "if imp is not None and len(imp) == len(avail):\n",
        "    top_n = 20\n",
        "    df_imp = (pd.DataFrame({\"feature\": avail, \"importance\": imp})\n",
        "              .sort_values(\"importance\", ascending=False).head(top_n))\n",
        "    df_imp[\"short\"] = df_imp[\"feature\"].str.split(\"-\").str[-1].str[:28]\n",
        "    colors_imp = plt.cm.RdYlGn_r(np.linspace(0.1, 0.9, len(df_imp)))\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(10, 8))\n",
        "    ax.barh(range(len(df_imp)), df_imp[\"importance\"].values[::-1], color=colors_imp[::-1], edgecolor=\"white\")\n",
        "    ax.set_yticks(range(len(df_imp)))\n",
        "    ax.set_yticklabels(df_imp[\"short\"].values[::-1], fontsize=9)\n",
        "    ax.set_xlabel(\"Mean |Coefficient| across classes\")\n",
        "    ax.set_title(f\"Top {top_n} Features — LinearSVC Coefficient Magnitude\", fontsize=13, fontweight=\"bold\")\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(\"/content/outputs/plots/08_feature_importance.png\", dpi=150, bbox_inches=\"tight\")\n",
        "    plt.show()\n",
        "    df_imp.to_csv(\"/content/outputs/feature_importance.csv\", index=False)\n",
        "    print(\"\\n📋 Top 10 most influential features (LinearSVC):\")\n",
        "    for _, row in df_imp.head(10).iterrows():\n",
        "        bar = \"█\" * int(row['importance'] / df_imp['importance'].max() * 30)\n",
        "        print(f\"  • {row['short']:<30}  |coef| = {row['importance']:.4f}  {bar}\")\n",
        "else:\n",
