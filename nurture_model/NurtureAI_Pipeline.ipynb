        "# ════════════════════════════════════════════════════════════\n",
        "#  STEP 2 — DATA CLEANING\n",
        "# ════════════════════════════════════════════════════════════\n",
        "\n",
        "def identify_cols(df):\n",
        "    num_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n",
        "    str_cols = [c for c in df.columns if df[c].dtype == object or str(df[c].dtype) == \"str\"]\n",
        "    id_cols  = [c for c in df.columns if c.lower() in (\"id\", \"uid\", \"participant_id\")]\n",
        "    num_feat = [c for c in num_cols if c not in [TARGET] + id_cols]\n",
        "    return id_cols, str_cols, num_feat\n",
        "\n",
        "\n",
        "def drop_high_missing(df, thresh=0.60):\n",
        "    frac  = df.isnull().mean()\n",
        "    drops = frac[frac > thresh].index.tolist()\n",
        "    if drops:\n",
        "        print(f\"  [DROP] {len(drops)} columns > {thresh*100:.0f}% missing: {drops}\")\n",
        "        df = df.drop(columns=drops)\n",
        "    return df, drops\n",
        "\n",
        "\n",
        "def encode_categoricals(df, str_cols):\n",
        "    encoded, dropped = [], []\n",
        "    for col in str_cols:\n",
        "        if col not in df.columns: continue\n",
        "        n_unique = df[col].nunique(dropna=True)\n",
        "        if n_unique <= 1 or n_unique > 10:\n",
        "            df = df.drop(columns=[col]); dropped.append(col)\n",
        "        elif n_unique == 2:\n",
        "            vals = sorted(df[col].dropna().unique())\n",
        "            df[col] = df[col].map({v: i for i, v in enumerate(vals)}); encoded.append(col)\n",
        "        else:\n",
        "            dummies = pd.get_dummies(df[col], prefix=col, drop_first=True)\n",
        "            df = pd.concat([df.drop(columns=[col]), dummies], axis=1); encoded.append(col)\n",
        "    if dropped: print(f\"  [DROP] High-cardinality cols: {dropped}\")\n",
        "    if encoded: print(f\"  [ENC]  Encoded: {encoded}\")\n",
        "    return df\n",
        "\n",
        "\n",
        "def remove_target_nulls(df):\n",
        "    before = len(df)\n",
        "    df = df.dropna(subset=[TARGET]).copy()\n",
        "    df[TARGET] = df[TARGET].astype(int)\n",
        "    print(f\"  [TARGET] Removed {before - len(df)} rows with missing sii — {len(df)} rows remain\")\n",
        "    return df\n",
        "\n",
        "\n",
        "def impute_numeric(df, cols):\n",
        "    present = [c for c in cols if c in df.columns]\n",
        "    if present:\n",
        "        imp = SimpleImputer(strategy=\"median\")\n",
        "        df[present] = imp.fit_transform(df[present])\n",
        "    return df\n",
        "\n",
        "\n",
        "def clean_pipeline(train, test=None):\n",
        "    print(\"\\n\" + \"=\"*55)\n",
        "    print(\"  STEP 2 — DATA CLEANING\")\n",
        "    print(\"=\"*55)\n",
        "\n",
        "    id_cols, str_cols, num_feat = identify_cols(train)\n",
        "\n",
        "    # 1. Drop ID columns\n",
        "    train = train.drop(columns=[c for c in id_cols if c in train.columns], errors=\"ignore\")\n",
        "    if test is not None:\n",
        "        test = test.drop(columns=[c for c in id_cols if c in test.columns], errors=\"ignore\")\n",
        "\n",
        "    # 2. Drop high-missing columns\n",
        "    train, dropped = drop_high_missing(train)\n",
        "    if test is not None:\n",
        "        test = test.drop(columns=[c for c in dropped if c in test.columns], errors=\"ignore\")\n",
        "\n",
        "    # 3. Encode categoricals\n",
        "    str_cols = [c for c in str_cols if c in train.columns and c not in id_cols]\n",
        "    train = encode_categoricals(train, str_cols)\n",
        "    if test is not None:\n",
        "        test = encode_categoricals(test, [c for c in str_cols if c in test.columns])\n",
        "\n",
        "    # 4. Remove rows with missing target\n",
        "    train = remove_target_nulls(train)\n",
        "\n",
        "    # 5. Impute numeric nulls\n",
        "    _, _, num_feat = identify_cols(train)\n",
        "    print(f\"  [IMPUTE] Median imputation on {len(num_feat)} numeric columns\")\n",
        "    train = impute_numeric(train, num_feat)\n",
        "    if test is not None:\n",
        "        _, _, num_feat_t = identify_cols(test)\n",
        "        test = impute_numeric(test, num_feat_t)\n",
        "\n",
        "    print(f\"\\n  ✅ Cleaned train : {train.shape[0]:,} rows x {train.shape[1]} cols\")\n",
        "    if test is not None: print(f\"  ✅ Cleaned test  : {test.shape[0]:,} rows x {test.shape[1]} cols\")\n",
        "    print(f\"  ✅ Remaining nulls (train) : {train.isnull().sum().sum()}\")\n",
        "    return train, test\n",
        "\n",
        "\n",
        "# Run cleaning\n",
        "train_clean, test_clean = clean_pipeline(train_raw.copy(), test_raw.copy() if test_raw is not None else None)\n",
        "\n",
        "print(\"\\n📄 Cleaned data sample:\")\n",
        "display(train_clean.head(3))\n"
      ]
    },
