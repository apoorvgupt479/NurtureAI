\"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 3.4227876699987805,\n        \"min\": 37.87764695136018,\n        \"max\": 44.694070743368485,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          40.73932310517142\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"BIA-BIA_SMM\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 12.886137352230993,\n        \"min\": 15.454393373218341,\n        \"max\": 41.14704340042564,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          15.454393373218341\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"sii\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1,\n        \"min\": 0,\n        \"max\": 3,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          3\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
