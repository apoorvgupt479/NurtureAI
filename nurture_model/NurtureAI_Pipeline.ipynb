        "               \"SDS-SDS_Total_T\": 36, \"PAQ_A-PAQ_A_Total\": 3.6,\n",
        "               \"Fitness_Endurance-Max_Stage\": 12, \"Fitness_Endurance-Time_Mins\": 45,\n",
        "               \"BIA-BIA_Fat\": 14, \"BIA-BIA_FFM\": 31, \"BIA-BIA_SMM\": 23}},\n",
