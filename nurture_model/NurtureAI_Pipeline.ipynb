      "source": [
        "import ast\n",
        "import re\n",
        "\n",
        "# Imports required for comprehensive model research\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn.svm import LinearSVC\n",
        "from sklearn.naive_bayes import GaussianNB\n",
        "from sklearn.ensemble import AdaBoostClassifier, GradientBoostingClassifier, RandomForestClassifier\n",
        "from sklearn.model_selection import RandomizedSearchCV, StratifiedKFold\n",
        "from sklearn.metrics import make_scorer, cohen_kappa_score, accuracy_score\n",
        "from scipy.stats import randint, uniform\n",
        "\n",
        "# Ensure XGBoost and LightGBM are imported if available in the environment\n",
        "try:\n",
        "    import xgboost as xgb\n",
        "    XGB_AVAILABLE = True\n",
        "except ImportError:\n",
        "    XGB_AVAILABLE = False\n",
        "try:\n",
        "    import lightgbm as lgb\n",
        "    LGB_AVAILABLE = True\n",
        "except ImportError:\n",
        "    LGB_AVAILABLE = False\n",
        "\n",
        "# ════════════════════════════════════════════════════════════\n",
        "#  STEP 5 — MODEL TRAINING & COMPREHENSIVE RESEARCH\n",
        "# ════════════════════════════════════════════════════════════\n",
        "\n",
        "# ── Custom Ordinal-Aware Classifier (baseline reference) ─────────\n",
        "class OrdinalRoundingClassifier:\n",
        "    \"\"\"\n",
        "    Trains a GradientBoosting Regressor and rounds predictions to nearest\n",
        "    valid ordinal class (0/1/2/3). Kept as a baseline for comparison.\n",
        "    \"\"\"\n",
        "    def __init__(self, n_estimators=300, max_depth=4, learning_rate=0.05):\n",
        "        self.model = GradientBoostingRegressor(\n",
        "            n_estimators=n_estimators, max_depth=max_depth,\n",
        "            learning_rate=learning_rate, subsample=0.8,\n",
        "            min_samples_leaf=5, random_state=42)\n",
        "        self.classes_ = None\n",
        "\n",
        "    def fit(self, X, y):\n",
        "        self.classes_ = np.array(sorted(np.unique(y)))\n",
        "        self.model.fit(X, y); return self\n",
        "\n",
        "    def predict(self, X):\n",
        "        raw = self.model.predict(X)\n",
        "        return np.clip(np.round(raw).astype(int), self.classes_.min(), self.classes_.max())\n",
        "\n",
        "    def predict_proba(self, X):\n",
        "        raw = self.model.predict(X)\n",
        "        proba = np.zeros((len(raw), len(self.classes_)))\n",
        "        for i, p in enumerate(raw):\n",
        "            d = -np.abs(self.classes_ - p); e = np.exp(d - d.max())\n",
        "            proba[i] = e / e.sum()\n",
        "        return proba\n",
        "\n",
        "    @property\n",
        "    def feature_importances_(self):\n",
        "        return self.model.feature_importances_\n",
        "\n",
        "\n",
        "# ── Training helper (used for CV in summary table, not for RandomizedSearchCV) ─────────────────────────\n",
        "def qwk(y_true, y_pred):\n",
        "    return cohen_kappa_score(y_true, y_pred, weights=\"quadratic\")\n",
        "\n",
        "\n",
        "# ── Prepare data ──────────────────────────────────────────────────\n",
        "print(\"\\n\" + \"=\"*55)\n",
        "print(\"  STEP 5 — MODEL TRAINING & COMPREHENSIVE RESEARCH\")\n",
        "print(\"=\"*55)\n",
        "\n",
        "y = train_feat[TARGET].astype(int)\n",
        "X = train_feat.drop(columns=[TARGET])\n",
        "\n",
        "print(f\"\\n  Samples  : {len(X):,}\")\n",
        "print(f\"  Features : {X.shape[1]}\")\n",
        "print(\"\\n  Class distribution:\")\n",
        "for v, c in y.value_counts().sort_index().items():\n",
        "    bar = \"█\" * int(c/len(y)*30)\n",
        "    print(f\"    sii={v}  {TARGET_LABELS[v]:<16}  {c:>5}  ({c/len(y)*100:.1f}%)  {bar}\")\n",
        "\n",
        "# Define QWK scorer for RandomizedSearchCV\n",
        "qwk_scorer = make_scorer(qwk)\n",
        "\n",
        "# Define the research models and their hyperparameter search spaces\n",
        "research_configs = {\n",
        "    \"LogisticRegression\": {\n",
        "        \"model\": LogisticRegression(max_iter=1000, class_weight=\"balanced\", random_state=42),\n",
        "        \"params\": {\n",
        "            \"C\": uniform(0.01, 10),\n",
        "            \"solver\": [\"lbfgs\", \"liblinear\"]\n",
        "        }\n",
        "    },\n",
        "    \"DecisionTree\": {\n",
        "        \"model\": DecisionTreeClassifier(class_weight=\"balanced\", random_state=42),\n",
        "        \"params\": {\n",
        "            \"max_depth\": [3, 5, 10, 20, None],\n",
        "            \"min_samples_split\": randint(2, 20),\n",
        "            \"criterion\": [\"gini\", \"entropy\"]\n",
        "        }\n",
        "    },\n",
        "    \"RandomForest\": {\n",
        "        \"model\": RandomForestClassifier(class_weight=\"balanced\", random_state=42, n_jobs=-1),\n",
        "        \"params\": {\n",
        "            \"n_estimators\": [100, 200, 300],\n",
        "            \"max_depth\": [5, 10, 20, None],\n",
        "            \"min_samples_leaf\": [1, 2, 4]\n",
        "        }\n",
        "    },\n",
        "    \"GradientBoosting\": {\n",
        "        \"model\": GradientBoostingClassifier(random_state=42),\n",
        "        \"params\": {\n",
        "          \"n_estimators\": [50, 100],\n",
        "          \"learning_rate\": [0.05, 0.1],\n",
        "          \"max_depth\": [2, 3]\n",
        "        }\n",
        "    },\n",
        "    \"LinearSVC\": {\n",
        "        \"model\": LinearSVC(class_weight=\"balanced\", random_state=42, dual=False, max_iter=2000),\n",
        "        \"params\": {\n",
        "            \"C\": uniform(0.05, 10)\n",
        "        }\n",
        "    },\n",
        "    \"AdaBoost\": {\n",
        "        \"model\": AdaBoostClassifier(random_state=42),\n",
        "        \"params\": {\n",
        "            \"n_estimators\": [50, 100, 200],\n",
        "            \"learning_rate\": [0.01, 0.1, 1.0]\n",
        "        }\n",
        "    },\n",
        "    \"GaussianNB\": {\n",
        "        \"model\": GaussianNB(),\n",
        "        \"params\": {\n",
        "            \"var_smoothing\": [1e-9, 1e-8, 1e-7]\n",
        "        }\n",
        "    },\n",
        "    \"OrdinalGB\": {\n",
        "        \"model\": OrdinalRoundingClassifier(), # Custom model, no params to tune with RandomizedSearchCV\n",
        "        \"params\": {}\n",
        "    }\n",
        "}\n",
        "\n",
        "# Add XGBoost if available\n",
        "if XGB_AVAILABLE:\n",
        "    research_configs[\"XGBoost\"] = {\n",
        "        \"model\": xgb.XGBClassifier(\n",
        "            random_state=42, n_jobs=-1, eval_metric=\"mlogloss\", use_label_encoder=False\n",
        "        ),\n",
        "        \"params\": {\n",
        "            \"n_estimators\": [100, 300],\n",
        "            \"learning_rate\": [0.01, 0.05, 0.1],\n",
        "            \"max_depth\": [3, 5, 7],\n",
        "            \"subsample\": [0.7, 0.9]\n",
        "        }\n",
        "    }\n",
        "\n",
        "# Add LightGBM if available\n",
        "if LGB_AVAILABLE:\n",
        "    research_configs[\"LightGBM\"] = {\n",
        "        \"model\": lgb.LGBMClassifier(\n",
        "            class_weight=\"balanced\", random_state=42, n_jobs=-1, verbose=-1\n",
        "        ),\n",
        "        \"params\": {\n",
        "            \"n_estimators\": [100, 300],\n",
        "            \"num_leaves\": [31, 63, 127],\n",
        "            \"learning_rate\": [0.01, 0.05, 0.1]\n",
        "        }\n",
        "    }\n",
        "\n",
        "# Initialize research_results list to store results\n",
        "research_results = []\n",
        "\n",
        "# Consolidated Tuning Loop for all models\n",
        "print(\"\\n--- Running Comprehensive Model Tuning Loop ---\")\n",
        "skf_search = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "for name, cfg in research_configs.items():\n",
        "    print(f\"\\n  Tuning {name}...\")\n",
        "\n",
        "    # Special handling for OrdinalGB as it's a custom class and doesn't use RandomizedSearchCV directly\n",
        "    if name == \"OrdinalGB\":\n",
        "        model_instance = cfg[\"model\"]\n",
        "        # Fit on full data for QWK calculation\n",
        "        model_instance.fit(X, y)\n",
        "        preds = model_instance.predict(X)\n",
        "        q = qwk(y, preds) # QWK on full training data (not CV here for simplicity, or could add custom CV)\n",
        "        acc = accuracy_score(y, preds)\n",
        "        best_params = {}\n",
        "        print(f\"    Done! QWK on training data: {q:.4f} | Train Acc: {acc:.4f}\")\n",
        "        best_mdl = model_instance\n",
        "        best_score = q\n",
        "    else:\n",
        "        search = RandomizedSearchCV(\n",
        "            cfg[\"model\"],\n",
        "            cfg[\"params\"],\n",
        "            n_iter=3, # Reduced for faster execution in demonstration\n",
        "            cv=skf_search,\n",
        "            scoring=qwk_scorer,\n",
        "            random_state=42,\n",
        "            n_jobs=-1, # Use all available cores\n",
        "            verbose=1\n",
        "        )\n",
        "        search.fit(X, y)\n",
        "\n",
        "        best_mdl = search.best_estimator_\n",
        "        best_score = search.best_score_\n",
        "\n",
        "        y_pred = best_mdl.predict(X)\n",
        "        acc = accuracy_score(y, y_pred)\n",
        "        best_params = search.best_params_\n",
        "\n",
        "        print(f\"    Done! Best CV QWK: {best_score:.4f} | Train Acc: {acc:.4f}\")\n",
        "\n",
        "    research_results.append({\n",
        "        \"Model\": name,\n",
        "        \"Best_QWK\": best_score,\n",
        "        \"Train_Accuracy\": acc,\n",
        "        \"Best_Params\": str(best_params),\n",
        "        \"Fitted_Model\": best_mdl # Store the fitted model instance\n",
        "    })\n",
        "\n",
        "# Sort results and determine the overall best model\n",
        "research_df = pd.DataFrame(research_results).sort_values(by=\"Best_QWK\", ascending=False)\n",
        "print(f\"\\n  {'='*60}\")\n",
        "print(f\"  Comprehensive Model Comparison Summary\")\n",
        "print(f\"  {'='*60}\")\n",
        "display(research_df[[\"Model\", \"Best_QWK\", \"Train_Accuracy\"]])\n",
        "\n",
        "overall_best_result = research_df.iloc[0]\n",
        "best_name = overall_best_result[\"Model\"]\n",
        "best_model = overall_best_result[\"Fitted_Model\"]\n",
        "best_q = overall_best_result[\"Best_QWK\"]\n",
        "\n",
        "# Save the overall best model and feature list\n",
        "joblib.dump(best_model, \"/content/models/best_model.pkl\")\n",
        "pd.DataFrame({\"feature\": X.columns.tolist()}).to_csv(\"/content/outputs/feature_names.csv\", index=False)\n",
        "feature_names = X.columns.tolist()\n",
        "\n",
        "print(f\"\\n  {'='*60}\")\n",
        "print(f\"  Overall Best Model Selected: {best_name} (QWK = {best_q:.4f})  ⭐\")\n",
        "print(f\"  {'='*60}\")\n",
        "print(\"\\n✅ Step 5 complete — overall best_model.pkl saved!\")\n"
      ]
