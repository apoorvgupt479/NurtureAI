        "     \"data\": {\"Basic_Demos-Age\": 15, \"Basic_Demos-Sex\": 1,\n",
        "               \"Physical-BMI\": 27, \"Physical-Height\": 165, \"Physical-Weight\": 73,\n",
        "               \"Physical-Waist_Circumference\": 85, \"Physical-Diastolic_BP\": 78,\n",
        "               \"Physical-Systolic_BP\": 126, \"Physical-HeartRate\": 88,\n",
        "               \"SDS-SDS_Total_T\": 63, \"PAQ_A-PAQ_A_Total\": 1.7,\n",
        "               \"Fitness_Endurance-Max_Stage\": 4, \"Fitness_Endurance-Time_Mins\": 11,\n",
        "               \"BIA-BIA_Fat\": 29, \"BIA-BIA_FFM\": 44, \"BIA-BIA_SMM\": 33}},\n",
        "    {\"name\": \"Child C — High Risk Profile\",\n",
        "     \"data\": {\"Basic_Demos-Age\": 17, \"Basic_Demos-Sex\": 1,\n",
        "               \"Physical-BMI\": 33, \"Physical-Height\": 170, \"Physical-Weight\": 95,\n",
        "               \"Physical-Waist_Circumference\": 102, \"Physical-Diastolic_BP\": 86,\n",
        "               \"Physical-Systolic_BP\": 139, \"Physical-HeartRate\": 99,\n",
        "               \"SDS-SDS_Total_T\": 76, \"PAQ_A-PAQ_A_Total\": 1.1,\n",
        "               \"Fitness_Endurance-Max_Stage\": 2, \"Fitness_Endurance-Time_Mins\": 5,\n",
        "               \"BIA-BIA_Fat\": 41, \"BIA-BIA_FFM\": 54, \"BIA-BIA_SMM\": 39}},\n",
        "]\n",
        "\n",
        "all_results = []\n",
        "for child in children:\n",
        "    r = predict_child(child[\"data\"], child[\"name\"])\n",
        "    all_results.append(r)\n",
        "\n",
