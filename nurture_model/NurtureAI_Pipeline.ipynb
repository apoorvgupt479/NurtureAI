      "source": [
        "import joblib\n",
        "\n",
        "# ════════════════════════════════════════════════════════════\n",
        "#  STEP 7 — PREDICT FOR NEW CHILDREN\n",
        "# ════════════════════════════════════════════════════════════\n",
        "\n",
        "RISK_LABELS = {0: \"None (Healthy)\", 1: \"Mild Risk\", 2: \"Moderate Risk\", 3: \"Severe Risk\"}\n",
        "RISK_EMOJI  = {0: \"🟢\", 1: \"🟡\", 2: \"🟠\", 3: \"🔴\"}\n",
        "RISK_COLOR  = {0: \"#2ecc71\", 1: \"#f1c40f\", 2: \"#e67e22\", 3: \"#e74c3c\"}\n",
        "\n",
        "\n",
        "def calc_behavior_score(data):\n",
        "    sds = data.get(\"SDS-SDS_Total_T\", 50)\n",
        "    paq = data.get(\"PAQ_A-PAQ_A_Total\", data.get(\"PAQ_C-PAQ_C_Total\", 2.5))\n",
        "    fit = data.get(\"Fitness_Endurance-Max_Stage\", 7)\n",
        "    bmi = data.get(\"Physical-BMI\", 22)\n",
        "    s = max(0,(80-sds)/80)*35 + max(0,(paq-1)/3)*35 + min(fit/15,1.0)*20 + max(0,(15-abs(bmi-21.5))/15)*10\n",
        "    return round(min(s, 100.0), 1)\n",
        "\n",
        "\n",
        "def get_recommendations(data, sii, score):\n",
        "    recs = []\n",
        "    sds = data.get(\"SDS-SDS_Total_T\", 50)\n",
        "    if sds > 55:  recs.append(\"😴 Sleep: High sleep disturbance — establish fixed bedtime, avoid screens 1hr before sleep.\")\n",
        "    elif sds < 40: recs.append(\"😴 Sleep: Good sleep pattern — maintain consistent times even on weekends.\")\n",
        "\n",
        "    paq = data.get(\"PAQ_A-PAQ_A_Total\", data.get(\"PAQ_C-PAQ_C_Total\", 2.5))\n",
        "    if paq < 2.0:  recs.append(\"🏃 Activity: Low activity — aim for 60 min moderate exercise daily.\")\n",
        "    elif paq >= 3: recs.append(\"🏃 Activity: Excellent activity level — keep it up!\")\n",
        "\n",
        "    bmi = data.get(\"Physical-BMI\", 22)\n",
        "    if bmi > 30:   recs.append(\"⚖️  Weight: Obese BMI — consult paediatrician for nutrition & activity plan.\")\n",
        "    elif bmi > 25: recs.append(\"⚖️  Weight: Overweight — encourage balanced meals, reduce high-calorie snacks.\")\n",
        "    elif bmi < 16: recs.append(\"⚖️  Weight: Underweight — ensure adequate nutrition, seek dietitian guidance.\")\n",
        "\n",
        "    hr = data.get(\"Physical-HeartRate\", 75)\n",
        "    if hr > 100: recs.append(\"❤️  Heart Rate: Elevated resting HR — try aerobic activities and breathing exercises.\")\n",
        "\n",
        "    fit = data.get(\"Fitness_Endurance-Max_Stage\", 7)\n",
        "    if fit < 5: recs.append(\"🏋️  Fitness: Low endurance — start light aerobic sessions 3–4×/week.\")\n",
        "\n",
        "    if sii >= 2:\n",
        "        recs.append(\"📱 Internet Use: Significant PIU risk — set screen limits (<2hrs recreational), use parental controls.\")\n",
        "        recs.append(\"🧠 Mental Health: Consider consulting a child psychologist for behavioural assessment.\")\n",
        "    elif sii == 1:\n",
        "        recs.append(\"📱 Internet Use: Mild concern — monitor screen time, promote offline hobbies.\")\n",
        "    else:\n",
        "        recs.append(\"✅ Great overall profile — keep encouraging sleep, activity and balanced screen time.\")\n",
        "\n",
        "    if   score < 40: recs.append(f\"📊 Behavior Score: {score}/100 — lifestyle improvements needed.\")\n",
        "    elif score < 65: recs.append(f\"📊 Behavior Score: {score}/100 — some factors need attention.\")\n",
        "    else:            recs.append(f\"📊 Behavior Score: {score}/100 — healthy behavioural profile.\")\n",
        "    return recs\n",
        "\n",
        "\n",
        "def predict_child(child_data, name=\"Child\"):\n",
        "    feat_list = pd.read_csv(\"/content/outputs/feature_names.csv\")[\"feature\"].tolist()\n",
        "    # Load the best LinearSVC model (saved as best_model.pkl)\n",
        "    model     = joblib.load(\"/content/models/best_model.pkl\")\n",
        "    X_input   = pd.DataFrame([child_data]).reindex(columns=feat_list, fill_value=0)\n",
        "\n",
        "    sii   = int(model.predict(X_input)[0])\n",
        "    proba = model.predict_proba(X_input)[0] if hasattr(model, \"predict_proba\") else None\n",
        "    score = calc_behavior_score(child_data)\n",
        "    recs  = get_recommendations(child_data, sii, score)\n",
        "\n",
        "    print(f\"\\n{'='*60}\")\n",
        "    print(f\"  NURTUREAI — {name}\")\n",
        "    print(f\"{'='*60}\")\n",
        "    print(f\"\\n  {RISK_EMOJI[sii]}  Risk Level     : sii = {sii}  →  {RISK_LABELS[sii]}\")\n",
        "    print(f\"  📊 Behavior Score  : {score} / 100\")\n",
        "\n",
        "    if proba is not None:\n",
        "        print(\"\\n  Class Probabilities:\")\n",
        "        for i, p in enumerate(proba):\n",
        "            bar = \"█\" * int(p * 30)\n",
        "            print(f\"    sii={i}  {RISK_LABELS[i]:<20}  {p:.3f}  {bar}\")\n",
        "\n",
        "    print(\"\\n  💡 Personalised Recommendations:\")\n",
        "    for i, r in enumerate(recs, 1):\n",
        "        print(f\"    {i}. {r}\")\n",
        "    print()\n",
        "    return {\"name\": name, \"sii\": sii, \"risk_label\": RISK_LABELS[sii], \"behavior_score\": score, \"probabilities\": proba}"
      ]
    },
