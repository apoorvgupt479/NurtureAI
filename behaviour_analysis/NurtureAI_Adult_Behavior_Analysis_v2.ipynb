    "# SAVE MODEL + METADATA AS PICKLE\n",
    "# ============================================================\n",
    "import pickle\n",
    "\n",
    "# Bundle everything needed for standalone prediction\n",
    "model_bundle = {\n",
    "    'model': rf,                         # trained Random Forest\n",
    "    'clf_features': clf_features,         # feature names in training order\n",
    "    'class_labels': list(rf.classes_),    # prediction labels\n",
