     ]
    }
   ],
   "source": [
    "# 2. Lifestyle Risk Score (Higher = worse unhealthy lifestyle)\n",
    "\n",
    "# Exercise: binary (already 1=Yes, 2=No) -> flag where 1 = no exercise (risky)\n",
    "df_fe['no_exercise_flag'] = df_fe['Exercise_Any'].apply(lambda x: 1 if x == 2 else 0)\n",
    "\n",
    "# Smoking: 1=Yes smoked 100 cigs -> risk\n",
    "df_fe['smoking_flag'] = df_fe['Smoked_100_Cigs'].apply(lambda x: 1 if x == 1 else 0)\n",
    "\n",
    "# Sleep quality as continuous score (0=optimal, 1=worst)\n",
    "# Optimal is 7-8 hours. Penalize proportionally for deviation.\n",
    "df_fe['sleep_quality_risk'] = df_fe['Sleep_Hours'].apply(\n",
    "    lambda x: min(abs(x - 7.5) / 4.5, 1.0)  # normalize: 3-12hrs maps to 0-1\n",
    ")\n",
    "\n",
    "# Alcohol: keep continuous, scale 0-1 (already parsed to days/month in Cell 13)\n",
    "# Don't binarize - preserve the gradient!\n",
    "alc_scaled = mms.fit_transform(df_fe[['Alcohol_Days_Monthly']])\n",
    "df_fe['alcohol_risk'] = alc_scaled\n",
    "\n",
    "# BMI deviation from healthy range as continuous\n",
    "df_fe['bmi_deviation'] = df_fe['BMI_Indicator'].apply(\n",
    "    lambda x: 0 if 18.5 <= x <= 25 else min(abs(x - 21.75) / 20, 1.0)\n",
    ")\n",
    "\n",
    "# WEIGHTED combination\n",
    "df_fe['Lifestyle_Risk_Score'] = (\n",
    "    df_fe['no_exercise_flag']   * 0.25 +\n",
    "    df_fe['smoking_flag']       * 0.20 +\n",
    "    df_fe['sleep_quality_risk'] * 0.20 +\n",
    "    df_fe['alcohol_risk']       * 0.20 +\n",
    "    df_fe['bmi_deviation']      * 0.15\n",
    ")\n",
    "\n",
    "print('Lifestyle_Risk_Score stats:')\n",
    "print(df_fe['Lifestyle_Risk_Score'].describe())\n"
   ]
  },
