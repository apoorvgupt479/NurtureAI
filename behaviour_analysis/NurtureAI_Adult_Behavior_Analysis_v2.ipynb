    "        'Sleep_Risk': float(subset['Sleep_Hours'].apply(lambda x: min(abs(x - 7.5) / 4.5, 1.0)).mean()),\n",
    "        'Exercise_Risk': float(subset['Exercise_Any'].apply(lambda x: 1 if x == 2 else 0).mean()),\n",
    "    }\n",
    "\n",
    "# Save\n",
    "with open('nurture_model.pkl', 'wb') as f:\n",
