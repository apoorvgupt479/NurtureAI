   "source": [
    "# 3. Physical Risk Score (Higher = worse)\n",
    "\n",
    "# Physical health days: already 0-30, higher = more sick days = worse\n",
    "# General Health: already 1-5, higher = worse\n",
    "# BMI: use continuous deviation instead of bucketed\n",
    "\n",
    "phys_raw = df_fe[['Physical_Health_Days', 'General_Health']].copy()\n",
    "phys_raw['bmi_risk_continuous'] = df_fe['BMI_Indicator'].apply(\n",
    "    lambda x: 0 if 18.5 <= x <= 25 else min(abs(x - 21.75) / 20, 1.0)\n",
    ")\n",
    "\n",
    "phys_scaled = pd.DataFrame(\n",
    "    mms.fit_transform(phys_raw),\n",
    "    columns=phys_raw.columns,\n",
    "    index=phys_raw.index\n",
    ")\n",
    "\n",
    "# Weighted: Physical health days is the strongest signal\n",
    "df_fe['Physical_Risk_Score'] = (\n",
    "    phys_scaled['Physical_Health_Days']  * 0.45 +\n",
    "    phys_scaled['General_Health']        * 0.35 +\n",
    "    phys_scaled['bmi_risk_continuous']   * 0.20\n",
    ")\n",
    "\n",
    "print('Physical_Risk_Score stats:')\n",
    "print(df_fe['Physical_Risk_Score'].describe())\n"
   ]
