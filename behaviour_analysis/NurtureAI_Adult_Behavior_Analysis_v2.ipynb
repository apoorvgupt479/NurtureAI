    "\n",
    "# Compute and store cluster average profiles for the radar chart comparison\n",
    "for label in ['Healthy Home Environment', 'Moderate Risk Environment', 'High Risk Environment']:\n",
    "    subset = df_sample[df_sample['Environment_Label'] == label]\n",
    "    model_bundle['cluster_profiles'][label] = {\n",
    "        'Mental_Stress_Score': float(subset['Mental_Stress_Score'].mean()),\n",
    "        'Lifestyle_Risk_Score': float(subset['Lifestyle_Risk_Score'].mean()),\n",
