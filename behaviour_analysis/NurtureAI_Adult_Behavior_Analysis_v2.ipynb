   "source": [
    "# ============================================================\n",
    "# PREDICTION & RISK ANALYSIS\n",
    "# ============================================================\n",
    "import numpy as np\n",
    "\n",
    "inp = {**user_input, **user_input_extended}\n",
    "\n",
    "# --- 1. Random Forest Prediction (using the 6 onboarding features) ---\n",
    "rf_input = pd.DataFrame([{k: user_input[k] for k in clf_features}])\n",
    "predicted_label = rf.predict(rf_input)[0]\n",
    "predicted_proba = rf.predict_proba(rf_input)[0]\n",
    "class_labels = rf.classes_\n",
    "\n",
    "# --- 2. Compute the three composite risk scores ---\n",
    "# Mental Stress Score\n",
    "depression_flag = 1 if inp['Depression_Diagnosis'] == 1 else 0\n",
    "sleep_deviation = abs(inp['Sleep_Hours'] - 7.5)\n",
    "\n",
    "# We need to scale using the same ranges the model was trained on\n",
    "# Using approximate min-max from the training data\n",
    "mental_days_norm = min(inp['Mental_Health_Days'] / 30.0, 1.0)\n",
    "sleep_dev_norm = min(sleep_deviation / 10.0, 1.0)  # max deviation ~10hrs\n",
    "gen_health_norm = (inp['General_Health'] - 1) / 4.0  # 1-5 -> 0-1\n",
    "\n",
    "mental_stress_score = (\n",
    "    mental_days_norm  * 0.40 +\n",
    "    depression_flag   * 0.25 +\n",
    "    gen_health_norm   * 0.20 +\n",
    "    sleep_dev_norm    * 0.15\n",
    ")\n",
    "\n",
    "# Lifestyle Risk Score\n",
    "no_exercise = 1 if inp['Exercise_Any'] == 2 else 0\n",
    "smoking = 1 if inp['Smoked_100_Cigs'] == 1 else 0\n",
    "sleep_quality_risk = min(abs(inp['Sleep_Hours'] - 7.5) / 4.5, 1.0)\n",
    "alcohol_risk = min(inp['Alcohol_Days_Monthly'] / 30.0, 1.0)\n",
    "bmi = inp['BMI_Indicator']\n",
    "bmi_deviation = 0 if 18.5 <= bmi <= 25 else min(abs(bmi - 21.75) / 20, 1.0)\n",
    "\n",
    "lifestyle_risk_score = (\n",
    "    no_exercise       * 0.25 +\n",
    "    smoking            * 0.20 +\n",
    "    sleep_quality_risk * 0.20 +\n",
    "    alcohol_risk       * 0.20 +\n",
    "    bmi_deviation      * 0.15\n",
    ")\n",
    "\n",
    "# Physical Risk Score\n",
    "phys_days_norm = min(inp['Physical_Health_Days'] / 30.0, 1.0)\n",
    "bmi_risk_cont = 0 if 18.5 <= bmi <= 25 else min(abs(bmi - 21.75) / 20, 1.0)\n",
    "\n",
    "physical_risk_score = (\n",
    "    phys_days_norm   * 0.45 +\n",
    "    gen_health_norm  * 0.35 +\n",
    "    bmi_risk_cont    * 0.20\n",
    ")\n",
    "\n",
    "total_risk = mental_stress_score + lifestyle_risk_score + physical_risk_score\n",
    "\n",
    "# --- 3. Generate Recommendations ---\n",
    "recommendations = []\n",
    "\n",
    "# Mental health recommendations\n",
    "if mental_stress_score > 0.5:\n",
    "    recommendations.append('\\U0001f9e0 HIGH Mental Stress: Consider professional counseling or therapy. Practice daily mindfulness (even 5 min/day helps).')\n",
    "    if depression_flag:\n",
    "        recommendations.append('\\U0001f4a1 Depression detected: Ensure ongoing treatment compliance. Consider support groups for parents.')\n",
    "elif mental_stress_score > 0.25:\n",
    "    recommendations.append('\\U0001f9e0 Moderate Mental Stress: Try journaling, regular breaks, and social connection. Monitor for escalation.')\n",
    "else:\n",
    "    recommendations.append('\\u2705 Mental Health: Looking good! Maintain your current stress management habits.')\n",
