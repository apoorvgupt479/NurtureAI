   ],
   "source": [
    "# 1. Mental Stress Score (Higher = worse)\n",
    "# Using available columns: Mental_Health_Days, Depression_Diagnosis, General_Health, Sleep_Hours\n",
    "\n",
    "# Depression as binary flag\n",
    "df_fe['depression_flag'] = df_fe['Depression_Diagnosis'].apply(lambda x: 1 if x == 1 else 0)\n",
    "\n",
    "# Sleep deviation from optimal (7-8 hrs) - continuous, captures both under and over-sleeping\n",
    "df_fe['sleep_deviation'] = df_fe['Sleep_Hours'].apply(lambda x: abs(x - 7.5))\n",
    "\n",
    "# General Health already mapped 1=Excellent to 5=Poor, so higher = worse (good for risk)\n",
    "# Scale all continuous components to 0-1 BEFORE combining\n",
    "stress_raw = df_fe[['Mental_Health_Days', 'sleep_deviation', 'General_Health']].copy()\n",
    "stress_raw['depression_flag'] = df_fe['depression_flag']\n",
    "\n",
    "stress_scaled = pd.DataFrame(\n",
    "    mms.fit_transform(stress_raw),\n",
    "    columns=stress_raw.columns,\n",
    "    index=stress_raw.index\n",
    ")\n",
    "\n",
    "# WEIGHTED combination - Mental_Health_Days is the strongest discriminator\n",
    "df_fe['Mental_Stress_Score'] = (\n",
    "    stress_scaled['Mental_Health_Days'] * 0.40 +\n",
    "    stress_scaled['depression_flag']    * 0.25 +\n",
    "    stress_scaled['General_Health']     * 0.20 +\n",
    "    stress_scaled['sleep_deviation']    * 0.15\n",
    ")\n",
    "\n",
    "print('Mental_Stress_Score stats:')\n",
    "print(df_fe['Mental_Stress_Score'].describe())\n"
   ]
  },
